{
  "name": "erasure",
  "id": "erasure",
  "type": "package",
  "author": "Lucide Networks",
  "description": "",
  "dependencies": [],
  "repo": {
    "url": "https://github.com/kxtzownsu/erasure.git"
  },
  "directory": "erasure",
  "build_script": [
    "make clean",
    "rustup target add ${MNFV_TARGET_ARCHITECTURE}-unknown-linux-musl",
    "make ${MNFV_TARGET_ARCHITECTURE}"
  ],
  "install_script": [
    "mkdir -p ${MNFV_INITFS_DIRECTORY}/bin",
    "cp build/${MNFV_TARGET_ARCHITECTURE}/erasure ${MNFV_INITFS_DIRECTORY}/bin/erasure"
  ]
}
