{
  "name": "libtsm",
  "id": "libtsm",
  "type": "dependency",
  "author": "Aetf",
  "description": "Terminal-emulator State Machine",
  "dependencies": [],
  "repo": {
    "url": "https://github.com/Aetf/libtsm.git",
    "branch": "v4.1.0"
  },
  "directory": "libtsm",
  "patches": true,
  "build_script": [
    "cmake -B build -S . \\",
    "  -DBUILD_SHARED_LIBS=off \\",
    "  -DCMAKE_C_COMPILER=${MNFV_CROSS_COMPILATION_ABS_CC} \\",
    "  -DCMAKE_AR=${MNFV_CROSS_COMPILATION_ABS_AR} \\",
    "  -DCMAKE_RANLIB=${MNFV_CROSS_COMPILATION_ABS_RANLIB} \\",
    "  -DCMAKE_INSTALL_PREFIX=${MNFV_INSTALL_PREFIX}",
    "cmake --build build"
  ],
  "install_script": [
    "cmake --install build"
  ]
}
