{
  "name": "libvncserver",
  "id": "libvncserver",
  "type": "dependency",
  "author": "libvnc",
  "description": "LibVNCServer/LibVNCClient are cross-platform C libraries that allow you to easily implement VNC server or client functionality in your program.",
  "dependencies": [
    "zlib"
  ],
  "repo": {
    "url": "https://github.com/libvnc/libvncserver.git",
    "commit": "98aaee0560baa0332339b2ef464ea96ed9b9b28c"
  },
  "directory": "libxml2",
  "build_script": [
    "cmake -B build -S . \\",
    "  -DBUILD_SHARED_LIBS=off \\",
    "  -DLIBXML2_WITH_CATALOG=off \\",
    "  -DLIBXML2_WITH_TESTS=off \\",
    "  -DLIBXML2_WITH_PROGRAMS=off \\",
    "  -DLIBXML2_WITH_PYTHON=off \\",
    "  -DLIBXML2_WITH_LZMA=off \\",
    "  -DLIBXML2_WITH_ICONV=off \\",
    "  -DCMAKE_C_COMPILER=${MNFV_CROSS_COMPILATION_ABS_CC} \\",
    "  -DCMAKE_AR=${MNFV_CROSS_COMPILATION_ABS_AR} \\",
    "  -DCMAKE_RANLIB=${MNFV_CROSS_COMPILATION_ABS_RANLIB} \\",
    "  -DCMAKE_INSTALL_PREFIX=${MNFV_INSTALL_PREFIX}",
    "cmake --build build"
  ],
  "install_script": [
    "cmake --install build"
  ]
}
