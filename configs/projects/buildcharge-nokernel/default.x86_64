CONFIG_ARCH_SELECTION_X86_64=y
# CONFIG_ARCH_SELECTION_AARCH64 is not set
CONFIG_ARCH_SELECTION="x86_64"

#
# Packages
#
CONFIG_PACKAGES=y
CONFIG_PACKAGE_FRECON=y
CONFIG_PACKAGE_FRECON_SHELL=y
CONFIG_PACKAGE_BUSYBOX=y
# end of Packages

#
# Kernel
#
# CONFIG_KERNEL is not set
# end of Kernel

CONFIG_KPART=n
CONFIG_PROJECT_NAME="buildcharge-nokernel"
